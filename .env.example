# Copy to .env and adjust. Values here are for LOCAL DEVELOPMENT ONLY.

POSTGRES_DB=traffic_light_predictor
POSTGRES_USER=tlp
POSTGRES_PASSWORD=change-me-local-only

# Shared key required to POST observations (X-Api-Key header). Generate your own, e.g.:
#   openssl rand -hex 24
TLP_INGEST_API_KEY=change-me-local-only

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
ML_PORT=8000
DB_PORT=5433

# Minutes of simulated history the demo feed posts on start-up.
TLP_FEED_BACKFILL_MINUTES=120

# Override if you prefer the official amd64-only image on x86 machines:
# POSTGIS_IMAGE=postgis/postgis:17-3.5
